{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moment",
  "version": "0.1.0",
  "identifier": "plus.aimo.moment",
  "build": {
    "devUrl": "https://moment.aimo.plus",
    "frontendDist": "https://moment.aimo.plus"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "时刻",
        "url": "https://moment.aimo.plus",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "时刻",
    "longDescription": "时刻桌面壳，打开线上的时光链。"
  }
}
