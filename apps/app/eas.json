{
  "cli": { "version": ">= 13.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://192.168.1.5:3000" }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://moment.aimo.plus",
        "EXPO_PUBLIC_WEB_URL": "https://moment.aimo.plus"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://moment.aimo.plus",
        "EXPO_PUBLIC_WEB_URL": "https://moment.aimo.plus"
      }
    }
  },
  "submit": { "production": {} }
}
