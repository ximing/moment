{
  "name": "@moment/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --exec node --loader ts-node/esm ./src/index.ts",
    "dev:tsx": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:generate": "drizzle-kit generate",
    "migrate:studio": "drizzle-kit studio",
    "worker": "cross-env NODE_ENV=development nodemon --exec node --loader ts-node/esm ./src/worker/index.ts",
    "setup:s3-lifecycle": "tsx scripts/setup-s3-lifecycle.ts",
    "backfill:extract": "tsx scripts/backfill-extract.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@lancedb/lancedb": "^0.37.1",
    "@moment/dto": "workspace:*",
    "ajv": "^8.17.1",
    "apache-arrow": "18.1.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.1",
    "expo-server-sdk": "^3.15.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "mysql2": "^3.18.2",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.1",
    "sharp": "^0.35.4",
    "typedi": "^0.10.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@moment/eslint-config": "workspace:*",
    "@moment/typescript-config": "workspace:*",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.19.0",
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
