NODE_ENV=development
PORT=3000

# MySQL —— 本地开发用 docker compose 的 mysql；测试务必用独立测试库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=moment
MYSQL_PASSWORD=moment_dev
MYSQL_DATABASE=moment_dev

# 32+ 字符随机串
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TTL_DAYS=7

# S3 兼容对象存储（私有桶，spec §5.3）
# E2E 说明：视觉回归不新增第二套 storage 配置，而是在 ignored 的 apps/server/.env.e2e 里
# 覆盖同一组变量：ATTACHMENT_S3_BUCKET=moment-e2e（私有桶）、
# ATTACHMENT_S3_ENDPOINT=http://127.0.0.1:9000（loopback）、ATTACHMENT_S3_PREFIX=e2e/attachments。
ATTACHMENT_S3_BUCKET=change-me-bucket
ATTACHMENT_S3_PREFIX=dev/attachments
# 自建 endpoint 留空则走 AWS 默认；非阿里云 endpoint 用 path-style
ATTACHMENT_S3_ENDPOINT=
ATTACHMENT_S3_REGION=cn-beijing
ATTACHMENT_S3_ACCESS_KEY_ID=change-me
ATTACHMENT_S3_SECRET_ACCESS_KEY=change-me
ATTACHMENT_S3_IS_PUBLIC=false

# 预签名有效期（GET 按整点时间窗对齐）
PRESIGN_GET_TTL_SECONDS=3600
PRESIGN_PUT_TTL_SECONDS=900
# 头像预签名 GET（秒），默认 6 天；S3 IAM 上限 7 天
AVATAR_PRESIGN_TTL_SECONDS=518400

# 设为 1 时跑 S3 真实桶 smoke 测试（tests/storage/s3-it.test.ts）；默认跳过
RUN_S3_IT=0

# Expo Push（worker 进程使用；无凭据可留空，Expo 推送免费层匿名可用）
EXPO_ACCESS_TOKEN=

# outbox worker（apps/server/src/worker/index.ts）
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=20

# Sweeper（worker 进程；生产首轮建议 SWEEPER_DRY_RUN=true 观察后再关）
SWEEPER_INTERVAL_MS=3600000
SWEEPER_DRY_RUN=false
MEDIA_UPLOADING_TTL_HOURS=24
MOMENT_SOFT_DELETE_RETENTION_DAYS=30

# E2E 视觉回归（默认关闭）。开启时另需 NODE_ENV=test 与 MYSQL_DATABASE=moment_e2e（专用空库）。
# 真实凭据只写 ignored 的 apps/server/.env.e2e 或 CI 的非生产 secret store，严禁入 tracked 文件。
MOMENT_E2E=0
MOMENT_E2E_OWNER_EMAIL=owner.e2e@moment.invalid
MOMENT_E2E_OWNER_PASSWORD=
MOMENT_E2E_VIEWER_EMAIL=viewer.e2e@moment.invalid
MOMENT_E2E_VIEWER_PASSWORD=

# AI 月度回顾 LLM（spec §3）
# OpenAI 兼容端点：DeepSeek/通义/Moonshot 同一协议，环境变量切换
LLM_BASE_URL=https://api.deepseek.com/v1
# 凭据；空 = recap 管线整体停用（本地开发默认不配置，扫描照常但跳过派发）
# 注意：moment 内容会出域到第三方 LLM，隐私敏感部署请留空（spec §8）
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 全局月度 token 预算，默认 0 = 不限；超限走降级（spec §5）
LLM_MONTHLY_TOKEN_BUDGET=0
# 生成调度时区（spec §1：每月1号按此时区判定）
LLM_RECAP_TZ=Asia/Shanghai
# 输入截断护栏（spec §4）
LLM_RECAP_MAX_MOMENTS=100
LLM_RECAP_MAX_CHARS=8000

# ---------- 语音转写 ASR（与 LLM_* 完全独立，可单独停用） ----------
# 阿里云百炼 DashScope fun-asr 异步任务 API；语音内容会出域到第三方 ASR（功能固有代价，无降级路径）
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 真实值仅放 ignored 的本地 env / 部署 secret；留空 = 停用转写（录音/播放不受影响）
ASR_API_KEY=
ASR_MODEL=fun-asr

# ---------- 逆地理编码 geocode（与 LLM_*/ASR_* 独立，可单独停用） ----------
# 高德 Web 服务 key（restapi.amap.com）。真实值仅放 ignored 的本地 env / 部署 secret。
# 隐私注意：配置后 worker 会把时刻坐标（WGS-84→GCJ-02 换算后）发送到高德做逆地理编码（spec §8）；
# 留空 = 停用（坐标照常落库，仅缺地名回填）
AMAP_WEB_KEY=

# 备份 sidecar（仅 docker-compose backup 服务读取；server/worker 不读，故不进 config.ts）
BACKUP_INTERVAL_SECONDS=86400
BACKUP_S3_BUCKET=change-me-backup-bucket
BACKUP_S3_PREFIX=backups/mysql
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=cn-beijing
BACKUP_S3_ACCESS_KEY_ID=change-me
BACKUP_S3_SECRET_ACCESS_KEY=change-me
