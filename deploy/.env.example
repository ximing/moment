# 生产部署环境变量。复制到仓库根目录：
#   cp deploy/.env.example .env
# 然后改真实值。.env 已 gitignore，严禁提交。
#
# docker compose -f docker-compose.prod.yml 会同时：
#   1) 读根目录 .env 做 ${} 插值（端口、MySQL 初始化）
#   2) 把同一文件注入 server / worker / backup 容器

# ----- 镜像（main 推送打 stable；也可钉 sha / v1.2.3） -----
MOMENT_IMAGE_TAG=stable

# ----- 对外端口（宿主机） -----
MOMENT_HTTP_PORT=80

# ----- MySQL（compose 内网，不对公网暴露 3306） -----
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=moment
MYSQL_PASSWORD=change-me-db-password
MYSQL_DATABASE=moment

# ----- JWT（≥32 字符随机串） -----
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TTL_DAYS=7

# ----- 对象存储（私有桶，必填；server 启动时 zod 校验） -----
# 阿里云 OSS / AWS S3 / Cloudflare R2 / 其它 S3 兼容均可
# 预签名 URL 会下发给浏览器，ENDPOINT 必须是浏览器能访问的公网地址
ATTACHMENT_S3_BUCKET=change-me-bucket
ATTACHMENT_S3_PREFIX=prod/attachments
ATTACHMENT_S3_ENDPOINT=
ATTACHMENT_S3_REGION=cn-beijing
ATTACHMENT_S3_ACCESS_KEY_ID=change-me
ATTACHMENT_S3_SECRET_ACCESS_KEY=change-me
ATTACHMENT_S3_IS_PUBLIC=false

PRESIGN_GET_TTL_SECONDS=21600
PRESIGN_PUT_TTL_SECONDS=900
AVATAR_PRESIGN_TTL_SECONDS=518400

# ----- Expo Push（可空） -----
EXPO_ACCESS_TOKEN=

# ----- worker -----
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=20

# 首次上线保持 true，看一轮 would delete 日志再改 false 重启 worker
SWEEPER_DRY_RUN=true
SWEEPER_INTERVAL_MS=3600000
MEDIA_UPLOADING_TTL_HOURS=24
MOMENT_SOFT_DELETE_RETENTION_DAYS=30

# ----- AI 月度回顾（空 key = 管线停用，内容不出域） -----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MONTHLY_TOKEN_BUDGET=0
LLM_RECAP_TZ=Asia/Shanghai
LLM_RECAP_MAX_MOMENTS=100
LLM_RECAP_MAX_CHARS=8000

# ----- fused retrieval Lance / BA（P4；DashScope provider 属 P5）-----
# server 独占 Lance 目录。compose server 会覆盖为 /data/lancedb。
LANCEDB_PATH=./lancedb_data
# 内部 BA 口共享密钥。空 = 一律 401 BA_NOT_CONFIGURED。生产必须设成长随机串（openssl rand -hex 32），
# 与 worker 同一值。严禁进前端包。
BA_AUTH_TOKEN=
# 仅 worker embed handler 使用（P5）。compose worker environment 覆盖为 http://server:3000。
INTERNAL_API_BASE_URL=http://127.0.0.1:3000
# 向量维。须 ∈ 2560,2048,1536,1024,768,512,256。换维必须换 LANCEDB_PATH 子目录或删表。
MULTIMODAL_EMBEDDING_DIMENSION=2560

# ----- fused retrieval DashScope embedding（P5）-----
# 空 key 或 ENABLED=false → getEmbeddingProvider()=null。不回退 ASR_API_KEY。
MULTIMODAL_EMBEDDING_ENABLED=true
MULTIMODAL_EMBEDDING_MODEL=qwen3-vl-embedding
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
MULTIMODAL_EMBEDDING_OUTPUT_TYPE=dense

# ----- 备份 sidecar（每日 mysqldump → S3） -----
BACKUP_INTERVAL_SECONDS=86400
BACKUP_S3_BUCKET=change-me-backup-bucket
BACKUP_S3_PREFIX=backups/mysql
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=cn-beijing
BACKUP_S3_ACCESS_KEY_ID=change-me
BACKUP_S3_SECRET_ACCESS_KEY=change-me
